# Server Configuration
PORT=8080
SERVER_HOST=localhost

# External API Keys
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
YOUTUBE_API_KEY=your_youtube_api_key
GENIUS_ACCESS_TOKEN=your_genius_access_token

# Redis Configuration (unified for cache + task queue)
REDIS_ADDR=localhost:6379          # Redis server address
REDIS_PASSWORD=                    # Redis password (leave empty for local)
REDIS_DB=0                         # Redis database number (0-15)
REDIS_TLS=false                    # Enable TLS (true/false) - set to true for Upstash/cloud Redis

# Rate Limiting
RATE_LIMIT_PER_MINUTE=200

# Database Configuration (PostgreSQL)
# Individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sptyt
DB_SSLMODE=disable

# Or use DSN (Data Source Name) format:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sptyt?sslmode=disable

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# DodoPay Configuration
DODOPAY_API_KEY=your_dodopay_api_key_here
DODOPAY_API_HOST=https://test.dodopayments.com
DODOPAY_PRODUCT_ID=your_dodopay_product_id_here
DODOPAY_WEBHOOK_SECRET=your_dodopay_webhook_secret_here
DODOPAY_RETURN_URL=https://yourdomain.com/payment/return

# YouTube OAuth Configuration
YOUTUBE_OAUTH_CLIENT_ID=your_client_id_here
YOUTUBE_OAUTH_CLIENT_SECRET=your_client_secret_here
YOUTUBE_OAUTH_REDIRECT_URI=https://sptyt.xyz/api/auth/youtube/callback
FRONTEND_URL=https://sptyt.xyz

# Debug (set to 1 to enable SQL query logging)
BUNDEBUG=0
